APP_NAME="Decent Ticket Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=decent_event
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=decent_event

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Decent Ticket Management specific ---

# QR signing (Ed25519) — see docs/06 §6.5. Store the private key in a secret
# manager in staging/production. Generate a keypair with
# `php artisan qr-signing:generate-key`.
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_KEY_ID=key-1
# Retired keys' public component only, JSON map key_id => base64 public key —
# populated during a rotation so tickets signed under a prior key keep
# verifying. Empty until the first rotation.
QR_SIGNING_PUBLIC_KEYS=

# Public frontend origin — where a payer's browser is sent back after a
# gateway session (success/fail/cancel), and the origin allowlisted in
# config/cors.php (Gap G2 — see the frontend's docs/00 §5). Local dev:
# http://localhost:3000 (already allowlisted unconditionally, doesn't need
# this var set). Production: https://101.nsbatihighschool.edu.bd
FRONTEND_URL=

# CMS ISR revalidation hook (Phase 3.5) — points at the frontend's own
# /api/revalidate route. Production: https://101.nsbatihighschool.edu.bd/api/revalidate
# CONTENT_REVALIDATE_SECRET must match the frontend's own env value exactly
# (sent back as `Authorization: Bearer <secret>`). Unset = no revalidation ping.
CONTENT_REVALIDATE_URL=
CONTENT_REVALIDATE_SECRET=

# Payment gateways (sandboxed locally; see docs/08 Phase 4)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=

ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_BASE_URL=

SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_BASE_URL=https://sandbox-gw.sslcommerz.com
SSLCOMMERZ_VALIDATION_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_IPN_IP_ALLOWLIST=

# SMS gateway (Bangladesh)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
SMS_GATEWAY_BASE_URL=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
